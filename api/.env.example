# Mall Platform 后端本地配置模板
# 用法：将本文件改为 .env 并填入真实值（.env 已被 .gitignore 忽略,不会上传到 GitHub）

# MySQL 连接（对应 application.yaml 的 spring.datasource）
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mall_platform
DB_USERNAME=root
DB_PASSWORD=your-mysql-password

# RustFS（对应 application.yaml 的 rustfs），默认与 docker-compose 的开发配置一致
# RUSTFS_ENDPOINT=http://127.0.0.1:9000
# RUSTFS_ACCESS_KEY=rustrf
# RUSTFS_SECRET_KEY=123456
# RUSTFS_REGION=us-east-1
# RUSTFS_BUCKET=mall-uploads

# Druid 监控页 /druid/ 的登录账号,不填默认为 druid / druid123
# DRUID_USERNAME=druid
# DRUID_PASSWORD=123456

# RocketMQ Proxy 的 gRPC 地址，不填默认为 127.0.0.1:8081
# ROCKETMQ_ENDPOINTS=127.0.0.1:8081

# Redis（商品缓存），不填默认为 127.0.0.1:6379
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379

# 下单后多久不支付自动取消，不填默认为 15m（本地调试可改成 30s）
# ORDER_PAY_TIMEOUT=15m
