# Mall Platform 后端本地配置模板
# 用法：将本文件改为 .env 并填入真实值（.env 已被 .gitignore 忽略,不会上传到 GitHub）

# MySQL 连接（对应 application.yaml 的 spring.datasource）
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mall_platform
DB_USERNAME=root
DB_PASSWORD=your-mysql-password

# RustFS（对应 application.yaml 的 rustfs），默认与 docker-compose 的开发配置一致
# RUSTFS_ENDPOINT=http://127.0.0.1:9000
# RUSTFS_ACCESS_KEY=rustrf
# RUSTFS_SECRET_KEY=123456
# RUSTFS_REGION=us-east-1
# RUSTFS_BUCKET=mall-uploads

# Druid 监控页 /druid/ 的登录账号,不填默认为 druid / druid123
# DRUID_USERNAME=druid
# DRUID_PASSWORD=123456

# RocketMQ Proxy 的 gRPC 地址，不填默认为 127.0.0.1:8081
# ROCKETMQ_ENDPOINTS=127.0.0.1:8081

# 收藏商品的上架、降价和涨价通知；测试环境可关闭消息发送与消费，收藏和历史通知仍可查询。
# PRODUCT_NOTIFICATION_DELIVERY_ENABLED=true
# WebSocket 允许的商城前端地址，多个地址用逗号分隔；部署或改前端端口时同步修改。
# NOTIFICATION_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Redis（商品缓存、下单锁和秒杀预扣），不填默认为 127.0.0.1:6379
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_USERNAME=
# REDIS_PASSWORD=
# REDIS_DATABASE=0
# 同一请求并发下单时的最长等锁时间，超时后可携带原请求号重试
# ORDER_CREATE_LOCK_WAIT=3s

# 下单后多久不支付自动取消，不填默认为 15m（本地调试可改成 30s）
# ORDER_PAY_TIMEOUT=15m
# 秒杀结束后自动归还未售配额，默认启用，每 30 秒扫描
# SECKILL_EXPIRY_ENABLED=true

# 支付宝沙箱：从支付宝开放平台沙箱控制台填写，密钥使用单行内容，不加引号。
ALIPAY_ENABLED=true
ALIPAY_APP_ID=
ALIPAY_APP_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
# ALIPAY_GATEWAY_URL=https://openapi-sandbox.dl.alipaydev.com/gateway.do
# 异步通知需要公网可访问地址；本机通过主动查询和定时对账同步支付结果。
# ALIPAY_NOTIFY_URL=https://localhost:8080/payment/alipay/notify
# ALIPAY_RETURN_URL=http://localhost:5173/payment/return

# 正式收款环境关闭模拟支付；定时对账默认每分钟查询待支付的支付宝流水。
# PAYMENT_MOCK_ENABLED=false
# PAYMENT_RECONCILE_ENABLED=true
