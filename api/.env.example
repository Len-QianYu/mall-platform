# Mall Platform 后端本地配置模板
# 用法：将本文件改为 .env 并填入真实值（.env 已被 .gitignore 忽略,不会上传到 GitHub）

# MySQL 连接（对应 application.yaml 的 spring.datasource）
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mall_platform
DB_USERNAME=root
DB_PASSWORD=your-mysql-password

# 上传文件的存放目录（对应 application.yaml 的 upload.root），不填默认为 用户目录/mall-platform/uploads
# UPLOAD_ROOT=D:/mall-platform/uploads
